{
  "name": "hashpaystream",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server.ts",
    "settlement:worker": "tsx scripts/upfront-settlement-daemon.ts",
    "settlement:preflight": "tsx scripts/upfront-settlement-worker-preflight.ts",
    "typecheck": "tsc --noEmit",
    "test:agreement-gateway": "node --import tsx scripts/agreement-gateway-smoke.mjs",
    "test:upfront-agreement-gateway": "node --import tsx scripts/upfront-agreement-gateway-smoke.mjs",
    "test:upfront-assessment": "node --import tsx scripts/upfront-v3-smoke.mjs && node --import tsx scripts/upfront-fees-smoke.mjs && node --import tsx scripts/upfront-assessment-smoke.mjs && node --import tsx scripts/polydesk-upfront-client-smoke.mjs && node --import tsx scripts/upfront-protection-attestation-smoke.mjs && node --import tsx scripts/upfront-protection-handler-smoke.mjs && node --import tsx scripts/upfront-opportunities-smoke.mjs",
    "test:upfront-reviews": "node --import tsx scripts/upfront-reviews-smoke.mjs",
    "test:funding-partners": "node --import tsx scripts/funding-partners-smoke.mjs",
    "test:stream-accounts": "node --import tsx scripts/stream-accounts-smoke.mjs",
    "test:circle-wallet": "node --import tsx scripts/circle-session-smoke.mjs && node --import tsx scripts/circle-wallet-smoke.mjs",
    "test:customer-requests": "node --import tsx scripts/customer-requests-smoke.mjs",
    "test:service-requests": "node --import tsx scripts/service-requests-smoke.mjs && node --import tsx scripts/service-requests-upfront-smoke.mjs",
    "test:notifications": "node --import tsx scripts/stream-notifications-smoke.mjs",
    "test:upfront-local-e2e": "node --import tsx scripts/upfront-local-e2e.mjs",
    "audit:upfront-mainnet": "node scripts/upfront-mainnet-readiness.mjs",
    "upfront:fund": "node scripts/fund-upfront-opportunity.mjs",
    "test:agent-agreement-gateway": "node --import tsx scripts/agent-agreement-gateway-smoke.mjs",
    "test:agent-credentials": "node --import tsx scripts/agent-credential-registry-smoke.mjs",
    "test:arc-webhook": "node --import tsx scripts/arc-agreement-webhook-smoke.mjs",
    "test:agent-arc-webhook": "node --import tsx scripts/agent-arc-webhook-smoke.mjs",
    "test:upfront-arc-webhook": "node --import tsx scripts/upfront-arc-webhook-smoke.mjs",
    "test:readiness": "node --import tsx scripts/readiness-smoke.mjs",
    "test:shutdown": "node --import tsx scripts/graceful-shutdown-smoke.mjs",
    "test:admin-analytics": "node --import tsx scripts/admin-analytics-smoke.mjs",
    "test:public-stats": "node --import tsx scripts/public-stats-smoke.mjs",
    "test:navigation-context": "node --import tsx scripts/stream-pay-path-smoke.mjs",
    "test:usdc-format": "node --import tsx scripts/usdc-format-smoke.mjs",
    "test:stable-lifecycle": "node --import tsx scripts/stable-lifecycle-smoke.mjs",
    "test:savings-schedule": "node --import tsx scripts/savings-schedule-smoke.mjs",
    "test:surface": "node scripts/standalone-surface-smoke.mjs",
    "test:smoke": "npm run test:agreement-gateway && npm run test:upfront-agreement-gateway && npm run test:upfront-assessment && npm run test:upfront-reviews && npm run test:upfront-settlement && npm run test:funding-partners && npm run test:stream-accounts && npm run test:circle-wallet && npm run test:usdc-format && npm run test:stable-lifecycle && npm run test:financial-core && npm run test:financial-core-inventory && npm run test:financial-core-reconciliation && npm run test:chain-receipt-evidence && npm run test:chain-receipt-index && npm run test:chain-receipt-backfill && npm run test:chain-receipt-rpc && npm run test:chain-receipt-ledger && npm run test:payment-receipts && npm run test:receipt-workflows && npm run test:financial-core-postgres-harness && npm run test:customer-requests && npm run test:service-requests && npm run test:notifications && npm run test:agent-credentials && npm run test:agent-agreement-gateway && npm run test:arc-webhook && npm run test:agent-arc-webhook && npm run test:upfront-arc-webhook && npm run test:circle-marketplace && npm run test:admin-analytics && npm run test:public-stats && npm run test:readiness && npm run test:shutdown && npm run test:navigation-context && npm run test:savings-schedule && npm run test:surface",
    "agent:credentials": "node --import tsx scripts/agent-credential-admin.mjs",
    "audit:database-recovery": "node --import tsx scripts/database-recovery-audit.mjs",
    "test:circle-marketplace": "node --import tsx scripts/circle-marketplace-smoke.mjs",
    "test:upfront-settlement": "node --import tsx scripts/upfront-settlement-worker-smoke.mjs",
    "test:upfront-settlement-daemon": "node --import tsx scripts/upfront-settlement-daemon-smoke.mjs",
    "test:upfront-settlement-preflight": "node scripts/upfront-settlement-worker-preflight-smoke.mjs",
    "test:savings-config": "node --import tsx scripts/savings-config-smoke.mjs",
    "test:financial-core": "node --import tsx scripts/financial-core-smoke.mjs",
    "test:financial-core-inventory": "node --import tsx scripts/financial-core-inventory-smoke.mjs",
    "test:financial-core-reconciliation": "node --import tsx scripts/financial-core-reconciliation-smoke.mjs",
    "test:chain-receipt-evidence": "node --import tsx scripts/chain-receipt-evidence-smoke.mjs",
    "test:chain-receipt-index": "node --import tsx scripts/chain-receipt-index-smoke.mjs",
    "test:chain-receipt-rpc": "node scripts/chain-receipt-rpc-smoke.mjs",
    "test:chain-receipt-backfill": "node scripts/chain-receipt-backfill-smoke.mjs",
    "test:financial-core-postgres-harness": "node scripts/financial-core-postgres-harness-smoke.mjs",
    "audit:financial-core-data": "node --import tsx scripts/audit-financial-core-data.mjs",
    "audit:financial-core-reconciliation": "node --import tsx scripts/reconcile-financial-core-data.mjs",
    "audit:chain-receipts": "node --import tsx scripts/backfill-chain-receipts.mjs --confirm-read-only-chain-audit",
    "backfill:chain-receipts:staging": "node --import tsx scripts/backfill-chain-receipts.mjs --confirm-staging-chain-index",
    "verify:financial-core-postgres": "node --import tsx scripts/verify-financial-core-postgres.mjs",
    "db:migrate:financial-core": "node --import tsx scripts/migrate-financial-core.mjs",
    "test:chain-receipt-ledger": "node --import tsx scripts/chain-receipt-ledger-smoke.mjs && node scripts/receipt-ledger-boundary-smoke.mjs",
    "test:payment-receipts": "node --import tsx scripts/payment-receipts-smoke.mjs",
    "backfill:receipt-ledger:staging": "node --import tsx scripts/backfill-receipt-ledger.mjs --confirm-staging-ledger-backfill",
    "verify:receipt-ledger:rollback": "node --import tsx scripts/backfill-receipt-ledger.mjs --confirm-rollback-only-ledger-check",
    "test:receipt-workflows": "node --import tsx scripts/receipt-workflow-smoke.mjs && node scripts/receipt-workflow-boundary-smoke.mjs",
    "audit:receipt-ownership": "node --import tsx scripts/audit-receipt-ownership.mjs --confirm-read-only-ownership-audit",
    "verify:receipt-workflows:rollback": "node --import tsx scripts/backfill-receipt-workflows.mjs --confirm-rollback-only-workflow-check",
    "backfill:receipt-workflows:staging": "node --import tsx scripts/backfill-receipt-workflows.mjs --confirm-staging-workflow-backfill",
    "sync:receipts:staging": "node --import tsx scripts/sync-receipt-workflows.mjs --confirm-staging-receipt-sync",
    "verify:receipt-incremental:postgres": "node --import tsx scripts/receipt-incremental-postgres.mjs --confirm-rollback-only-incremental-check",
    "staging:receipt-server": "node --import tsx scripts/serve-staging-receipts.mjs"
  },
  "dependencies": {
    "@circle-fin/w3s-pw-web-sdk": "^1.1.11",
    "@circle-fin/x402-batching": "^3.3.0",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@heroicons/react": "^2.2.0",
    "@privy-io/node": "0.28.0",
    "@privy-io/react-auth": "3.28.0",
    "@x402/core": "^2.21.0",
    "@x402/evm": "^2.21.0",
    "express": "^4.19.2",
    "pg": "^8.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "viem": "^2.51.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "5.1.4",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.3",
    "vite": "7.3.6",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "overrides": {
    "undici": "6.28.0",
    "uuid": "11.1.1",
    "@coinbase/cdp-sdk": {
      "axios": "1.19.0"
    },
    "viem": {
      "ws": "8.21.2"
    }
  }
}
