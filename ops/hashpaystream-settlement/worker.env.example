# Copy to /etc/hashpaystream-worker/worker.env with mode 0640 and root:hashpaystream ownership.
# Never commit real values. The service must remain stopped until every placeholder is replaced.
HASHPAYSTREAM_SETTLEMENT_WORKER_ENABLED=true
HASHPAYSTREAM_SETTLEMENT_WORKER_INTERVAL_MS=30000
HASHPAYSTREAM_UPFRONT_AUTO_SETTLEMENT_ENABLED=true
DATABASE_URL=SET_BEFORE_START
HASHPAYSTREAM_UPFRONT_STORE_KEY=hashpaystream:upfront-assessments:v1
HASHPAYSTREAM_UPFRONT_ARC_API_KEY=SET_BEFORE_START
HASHPAYSTREAM_HASH_PAYLINK_BASE_URL=https://app.hashpaylink.com
HASHPAYSTREAM_XLAYER_RPC_URL=https://rpc.xlayer.tech
HASHPAYSTREAM_UPFRONT_ESCROW_CONTRACT_ADDRESS=SET_BEFORE_START
HASHPAYSTREAM_ARC_RPC_URL=https://rpc.testnet.arc.network
HASHPAYSTREAM_UPFRONT_ARC_ROUTER_ADDRESS=SET_BEFORE_START
HASHPAYSTREAM_UPFRONT_REPAYMENT_PRIVATE_KEY=SET_BEFORE_START
HASHPAYSTREAM_UPFRONT_REPAYMENT_SIGNER=SET_BEFORE_START
