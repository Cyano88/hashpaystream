{
  "name": "@hashpaystream/upfront-contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:upfront": "hardhat test test/UpfrontAdvanceEscrow.test.ts test/ArcRepaymentRouter.test.ts",
    "test:savings": "hardhat test test/PersonalSavingsVault.test.ts test/LockedSavingsCohortVault.test.ts",
    "audit:personal-savings": "hardhat compile && hardhat test test/PersonalSavingsVault.test.ts && node scripts/verify-personal-savings-review.mjs && node scripts/verify-personal-savings-arc-testnet-review.mjs",
    "bootstrap:keys": "tsx scripts/bootstrap-local-keys.ts",
    "bootstrap:mainnet-deployer": "tsx scripts/bootstrap-mainnet-deployer.ts",
    "plan:arc-testnet": "hardhat run scripts/plan-arc.ts --network arcTestnet",
    "plan:testnet": "hardhat run scripts/plan-xlayer.ts --network xlayerTestnet",
    "plan:mainnet": "hardhat run scripts/plan-mainnet.ts --network xlayerMainnet",
    "deploy:test-usdc": "hardhat run scripts/deploy-test-usdc.ts --network xlayerTestnet",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network xlayerTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy-mainnet.ts --network xlayerMainnet",
    "deploy:savings-mainnet": "hardhat run scripts/deploy-savings-mainnet.ts --network xlayerMainnet",
    "deploy:savings-arc-testnet": "hardhat run scripts/deploy-savings-arc-testnet.ts --network arcTestnet",
    "deploy:locked-savings-mainnet": "hardhat run scripts/deploy-locked-savings-mainnet.ts --network xlayerMainnet",
    "verify:savings-arc-testnet": "node scripts/verify-personal-savings-arc-testnet-deployment.mjs",
    "rehearse:savings-arc-testnet": "hardhat run scripts/rehearse-personal-savings-arc-testnet.ts --network arcTestnet",
    "verify:reviewed-mainnet": "hardhat run scripts/verify-reviewed-deployment.ts --network xlayerMainnet",
    "verify:reviewed-arc-testnet": "hardhat run scripts/verify-reviewed-deployment.ts --network arcTestnet",
    "verify:mainnet": "hardhat run scripts/verify-mainnet.ts --network xlayerMainnet",
    "verify:arc-testnet": "hardhat run scripts/verify-deployment.ts --network arcTestnet",
    "verify:xlayer-testnet": "hardhat run scripts/verify-deployment.ts --network xlayerTestnet",
    "verify:xlayer-mainnet": "hardhat run scripts/verify-deployment.ts --network xlayerMainnet",
    "deploy:arc-testnet": "hardhat run scripts/deploy-arc.ts --network arcTestnet",
    "deploy:stock-mainnet": "hardhat run scripts/deploy-stock-delivery-mainnet.ts --network xlayerMainnet",
    "verify:stock-mainnet": "hardhat run scripts/verify-stock-delivery-mainnet.ts --network xlayerMainnet",
    "plan:stock-owner-safe": "hardhat run scripts/plan-stock-owner-safe-mainnet.ts --network xlayerMainnet",
    "create:stock-owner-safe": "hardhat run scripts/create-stock-owner-safe-mainnet.ts --network xlayerMainnet",
    "verify:stock-owner-safe": "hardhat run scripts/verify-stock-owner-safe-mainnet.ts --network xlayerMainnet",
    "test:stock-deployment": "hardhat test test/AgreementBackedStockDelivery.test.ts test/StockDeliveryDeploymentGuards.test.ts test/StockOwnerSafeVerification.test.ts test/StockOwnerSafePlanning.test.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "5.0.2",
    "dotenv": "^16.4.0",
    "hardhat": "^2.22.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0"
  }
}
